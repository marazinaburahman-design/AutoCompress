{
  "name": "autocompress",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first Windows desktop file automation",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:renderer": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && npm run generate:icon && electron-builder --win nsis --x64",
    "generate:icon": "node scripts/generate-icon.js",
    "test": "vitest run",
    "test:electron": "node scripts/smoke-electron.js",
    "test:packaged": "node scripts/smoke-packaged.js",
    "test:watch": "vitest",
    "rebuild:native": "electron-rebuild -w better-sqlite3",
    "start:electron": "npm start"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "better-sqlite3": "13.0.3",
    "chokidar": "5.0.0",
    "file-type": "22.3.0",
    "lucide-react": "1.66.0",
    "pdf-lib": "^1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "saxes": "^6.0.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@playwright/test": "1.64.1",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "build": {
    "appId": "com.autocompress.desktop",
    "productName": "AutoCompress",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/main/**",
      "src/preload/**",
      "dist/renderer/**",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": false,
    "win": {
      "icon": "src/main/assets/app.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
